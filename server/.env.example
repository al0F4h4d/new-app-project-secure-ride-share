# ==============================================================================
# SECURERIDE BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (MongoDB Atlas / Replica Set)
MONGODB_URI=mongodb://127.0.0.1:27017/secureride_dev?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=50

# Cache & Message Broker (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cryptography (AES-256-GCM for PII: 32 bytes = 64 hex chars)
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Object Storage (Cloudflare R2 / AWS S3 Compatible)
CLOUDFLARE_R2_ACCOUNT_ID=sample_r2_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=sample_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=sample_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=secureride-media-dev
CLOUDFLARE_R2_PUBLIC_URL=https://media.secureride.com.bd

# AWS Services (Textract & Rekognition)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=sample_aws_access_key
AWS_SECRET_ACCESS_KEY=sample_aws_secret_key

# Mobile Financial Services (bKash & Nagad)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=sample_bkash_key
BKASH_APP_SECRET=sample_bkash_secret
BKASH_USERNAME=sample_bkash_user
BKASH_PASSWORD=sample_bkash_pass
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=sample_nagad_merchant
NAGAD_PG_PUBLIC_KEY=sample_nagad_pg_pub_key
NAGAD_MERCHANT_PRIVATE_KEY=sample_nagad_priv_key

# SMS Gateways (SSL Wireless & Twilio)
SSL_WIRELESS_API_KEY=sample_ssl_key
SSL_WIRELESS_SID=sample_ssl_sid
SSL_WIRELESS_URL=https://smsplus.sslwireless.com/api/v3/send-sms
TWILIO_ACCOUNT_SID=sample_twilio_sid
TWILIO_AUTH_TOKEN=sample_twilio_auth_token
TWILIO_SERVICE_SID=sample_twilio_service_sid

